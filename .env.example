# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)
# AI 키는 서버 코드 전용입니다. 화면 코드/GitHub에 절대 넣지 않습니다.

# OCR·적요 AI — 둘 중 하나만 있으면 됩니다. 둘 다 있으면 Claude 우선
# Google Gemini (무료 사용량): https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# (선택) 모델 이름. 비우면 둘 다 gemini-3.5-flash-lite (무료 하루 500회)
# OCR만 Flash로 시험해 보려면 GEMINI_OCR_MODEL=gemini-3.5-flash (무료 하루 20회)
GEMINI_OCR_MODEL=
GEMINI_MEMO_MODEL=
# Claude API (유료 크레딧 필요): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase — 비워 두면 로컬 개발 시 .data/ 폴더에 저장됩니다 (Vercel 배포 시에는 필수)
SUPABASE_URL=
# Supabase 서버 전용 키(Secret key / service_role). 서버 코드에서만 사용
SUPABASE_SECRET_KEY=

# (선택) 카드 사용내역 조회 웹페이지(B) 주소. 비우면 같은 주소의 /card 를 사용
CARD_SOURCE_URL=
